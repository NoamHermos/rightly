{
  "manifest_version": 3,
  "name": "Rightly for ChatGPT",
  "version": "1.0.14",
  "description": "תיקון אוטומטי לכיוון וליישור עברית ב־ChatGPT, גם במשפטים שמתחילים במילה באנגלית.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rightly — תיקון עברית ב־ChatGPT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "css": ["chatgpt-rtl.css"],
      "js": ["vendor/katex/katex.min.js", "vendor/katex/base-metrics.js", "hebrew-math.js", "chatgpt-rtl.js"],
      "run_at": "document_idle"
    }
  ]
}
